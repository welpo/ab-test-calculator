#!/usr/bin/env bash

function error_exit() {
    echo "ERROR: $1" >&2
    exit "${2:-1}"
}

function get_file_hash() {
    if command -v md5sum >/dev/null 2>&1; then
        md5sum "$1" | cut -d' ' -f1 | head -c 8
    else
        md5 -q "$1" | head -c 8
    fi
}

function contains_todo() {
    local file="$1"
    grep -q "TODO" "$file"
}

function has_unstaged_changes() {
    local file="$1"
    [[ -n $(git diff -- "$file") ]]
}

# Files to watch for cache busting (relative to app/)
APP_FILES_TO_CACHEBUST=(
    "statistics.js"
    "app.js"
    "styles.css"
    "noscript.css"
    "sw-registration.js"
    "manifest.json"
)

STABLE_ASSETS=(
    "index.html"
    "favicon-16x16.png"
    "favicon-32x32.png"
    "favicon-48x48.png"
    "favicon-96x96.png"
    "favicon-192x192.png"
    "favicon.ico"
    "icon-512x512.png"
    "icon-maskable-192x192.png"
    "icon-maskable-512x512.png"
    "apple-touch-icon.png"
)

# Files imported by app.js
APP_JS_IMPORTS=(
    "statistics.js"
)

# Check if oxipng is installed.
png_compressor=""
if command -v oxipng &> /dev/null; then
    png_compressor="oxipng -o max"
elif command -v optipng &> /dev/null; then
    png_compressor="optipng -o 7"
fi

mapfile -t all_changed_files < <(git diff --cached --name-only)

app_files_staged=false
for file in "${all_changed_files[@]}"; do
    [[ "$file" == app/* ]] && app_files_staged=true
done

if [[ "$app_files_staged" == true ]]; then
    protected_files=("app/index.html" "app/app.js" "app/sw.js")
    for asset in "${APP_FILES_TO_CACHEBUST[@]}" "${STABLE_ASSETS[@]}"; do
        protected_files+=("app/$asset")
    done
    for file in "${protected_files[@]}"; do
        if has_unstaged_changes "$file"; then
            error_exit "$file has unstaged changes. Commit or stash them before proceeding."
        fi
    done
fi

script_name=$(basename "$0")
for file in "${all_changed_files[@]}"; do
    file_name=$(basename "$file")

    # Ignore this script and the changelog.
    if [[ "$file_name" == "$script_name" ]] || [[ "$file_name" == "CHANGELOG.md" ]]; then
        continue
    fi

    if ! git cat-file -e ":$file" 2>/dev/null; then
        continue
    fi

    # If the file is a PNG and png_compressor is set, compress it and add it to the commit.
    if [[ "$file" == *.png ]] && [[ -n "$png_compressor" ]]; then
        $png_compressor "$file" || error_exit "Failed to compress PNG file $file"
        git add --force "$file" || error_exit "Failed to add compressed PNG file $file"
        continue
    fi

    # If the file contains "TODO", abort the commit.
    if contains_todo "$file"; then
        error_exit "File $file contains TODO! Remove or complete the TODO before committing."
    fi

    if has_unstaged_changes "app/index.html"; then
        error_exit "index.html has unstaged changes. Commit or stash them before proceeding."
    fi
done

[[ "$app_files_staged" == true ]] || exit 0

fingerprint=""
declare -A hashes
for asset in "${APP_FILES_TO_CACHEBUST[@]}"; do
    asset_path="app/$asset"
    [[ -f "$asset_path" ]] || error_exit "Precached asset $asset_path is missing."

    hash=$(get_file_hash "$asset_path")
    hashes["$asset"]=$hash
    fingerprint+="$asset:$hash"$'\n'

    perl -0777 -pi -e "s{([\"'])((?:\\./|/)?)\\Q$asset\\E(?:\\?h=[0-9a-f]{8})?\\1}{\${1}\${2}$asset?h=$hash\${1}}g" app/index.html

    if [[ " ${APP_JS_IMPORTS[*]} " =~ ${asset} ]]; then
        perl -pi -e "s|from \"./${asset}(?:\\?[^\"]*)?\"|from \"./${asset}?h=${hash}\"|g" app/app.js
    fi
done

for asset in "${STABLE_ASSETS[@]}"; do
    asset_path="app/$asset"
    [[ -f "$asset_path" ]] || error_exit "Precached asset $asset_path is missing."
    fingerprint+="$asset:$(get_file_hash "$asset_path")"$'\n'
done

if command -v md5sum >/dev/null 2>&1; then
    cache_name="ab-calc-cache-$(printf '%s' "$fingerprint" | md5sum | cut -d' ' -f1 | head -c 8)"
else
    cache_name="ab-calc-cache-$(printf '%s' "$fingerprint" | md5 -q | head -c 8)"
fi

manifest="  '/',"$'\n'"  '/index.html',"
for asset in "${APP_FILES_TO_CACHEBUST[@]}"; do
    manifest+=$'\n'"  '/$asset?h=${hashes[$asset]}',"
done
for asset in "${STABLE_ASSETS[@]}"; do
    [[ "$asset" == "index.html" ]] || manifest+=$'\n'"  '/$asset',"
done
manifest=${manifest%,}

generated="// GENERATED BLOCK"$'\n'
generated+="const CACHE_NAME = '$cache_name';"$'\n'
generated+="const ASSETS_TO_CACHE = ["$'\n'
generated+="$manifest"$'\n'
generated+="];"$'\n'
generated+="// END GENERATED BLOCK"

SW_BLOCK="$generated" perl -0777 -pi -e 's{// GENERATED BLOCK.*?// END GENERATED BLOCK}{$ENV{SW_BLOCK}}s or die "missing generated block\n"' app/sw.js
git add app/index.html app/app.js app/sw.js
